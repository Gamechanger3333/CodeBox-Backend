# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development              # "production" hides error details + disables /docs
FRONTEND_URL=http://localhost:3000

# ── Database (same Postgres your Node/Prisma app used) ──
# Prisma-style URLs work as-is (?sslmode=require&pgbouncer=true are understood).
DATABASE_URL="postgresql://user:password@localhost:5432/codebox"

# ── Auth ────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"     # >= 32 chars. Use the SAME value as before so old tokens stay valid.
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7           # days

# ── AI ──────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"

# ── Embeddings for RAG ──────────────────────────────────
EMBEDDING_PROVIDER=ollama         # or "gemini"
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=                   # only needed when EMBEDDING_PROVIDER=gemini

# ── E-mail (password reset OTP) ─────────────────────────
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="CodeBox <noreply@yourdomain.com>"

# ── Demo account ────────────────────────────────────────
DEMO_USER_EMAIL=demo@codebox.com
DEMO_USER_PASSWORD_SEED=Demo@1234
