datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  avatar          String?
  bio             String?
  isVerified      Boolean          @default(false)
  otpCode         String?
  otpExpiry       DateTime?
  otpAttempts     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  conversations   Conversation[]
  snippets        Snippet[]
  projectSession  ProjectSession?
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  isPinned  Boolean   @default(false)
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String       // "user" | "bot"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model Snippet {
  id          String   @id @default(uuid())
  title       String
  code        String   @db.Text
  language    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  isPublic    Boolean  @default(false)
}

model ConversationIdOnly {
  id String @id
}

// Stores the full project context in the DB so it survives server restarts.
// One row per user — uploading a new ZIP replaces the old one (upsert).
model ProjectSession {
  id          String   @id @default(uuid())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectName String
  fileTree    String   @db.Text          // plain text tree
  files       String   @db.Text          // JSON: { path, content }[]
  stats       String                     // JSON: { total, analyzed, skipped, totalChars }
  analysis    String   @db.Text          // initial AI analysis markdown
  history     String   @db.Text @default("[]") // JSON: { role, content }[]
  ragStatus   String   @default("pending")     // "pending" | "ready" | "failed" — tracks background chunk ingestion
  ragChunkCount Int    @default(0)             // how many chunks were indexed once ready
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks a content hash per (sessionId, filePath) so re-uploads can skip
// re-chunking/re-embedding files that haven't actually changed — embedding
// is the slow, CPU-bound step, so avoiding redundant work here matters.
model IngestedFileHash {
  id          String   @id @default(uuid())
  sessionId   String
  filePath    String
  contentHash String
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, filePath])
  @@index([sessionId])
}
// Stores individual embedded chunks of a user's uploaded project, used for
// RAG retrieval during follow-up Q&A. sessionId is a String (not a relation)
// because it's set to String(userId), matching the Int -> String conversion
// used throughout ragEngine.js.
model CodeChunk {
  id        String   @id @default(uuid())
  sessionId String
  filePath  String
  content   String   @db.Text
  embedding Json
  createdAt DateTime @default(now())

  @@index([sessionId])
}
